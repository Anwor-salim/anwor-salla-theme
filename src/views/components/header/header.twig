{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}
<header data-testid="store-header" class="store-header sticky top-0 z-50 transition-all duration-300">
  {# Luxury Fragrance Announcement Bar #}
  {% if theme.settings.get('show_top_ribbon', true) %}
  <div class="perfume-top-ribbon bg-[#d4b07c] text-[#121316] text-xs py-1.5 px-4 shadow-sm border-b border-[#cca36e]/40">
    <div class="container flex items-center justify-between text-xs font-semibold">
      <div class="flex items-center gap-2 text-[#121316]/80">
        <button type="button" class="hover:opacity-70 transition-opacity flex items-center" aria-label="السابق"><i class="sicon-keyboard_arrow_right text-xs"></i></button>
        <button type="button" class="hover:opacity-70 transition-opacity flex items-center" aria-label="التالي"><i class="sicon-keyboard_arrow_left text-xs"></i></button>
      </div>
      <div class="flex-1 text-center font-bold tracking-wide">
        <span class="inline-flex items-center gap-1.5">
          <span>عطور مختارة بعناية لأجمل لحظاتك</span>
        </span>
      </div>
      <div class="hidden sm:flex items-center gap-1.5 font-bold text-xs text-[#121316]">
        <i class="sicon-delivery-truck text-sm"></i>
        <span>شحن مجاني للطلبات فوق 500 ريال</span>
      </div>
    </div>
  </div>
  {% endif %}

  {# Bullet Delivery tag — mobile #}
  <div class="lg:hidden">
    <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
  </div>

  {# Top Nav #}
  <div class="top-navbar">
    <div class="container flex justify-between items-center">
      <div class="flex-1 flex items-center gap-3">
          {# Footer / Header Extra Menu #}
          {% if important_links %}
            <salla-menu data-testid="store-header-topnav" source="footer" topnav></salla-menu>
          {% endif %}

          {# Language & Currency Component #}
          <div class="header-buttons">
              {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
                  <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
              {% endif %}
          </div>

          {# Bullet Delivery tag — desktop #}
          <div class="hidden lg:block">
            <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
          </div>

          {# Scopes | Branches #}
          {% if store.scope %}
              <button class="btn--rounded-gray text-xs"
                      onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
                  <i class="sicon-location rtl:ml-1 ltr:mr-1 text-[#c5a880]"></i> {{ store.scope.name }}
              </button>
          {% endif %}

          {# Search bar #}
          <div class="header-search flex-1 max-w-md">
            <salla-search data-testid="store-header-search" inline oval height="40" placeholder="ابحث عن عطر، ماركة، أو مكونات..."></salla-search>
          </div>
      </div>

      <salla-contacts data-testid="store-header-contacts" is-header></salla-contacts>
    </div>
  </div>

  {# Main Navigation Header Bar #}
  <div id="mainnav" class="main-nav-container shadow-default bg-[#141518] flex items-center">
      <div class="inner bg-inherit w-full">
          <div class="container">
              <div class="flex items-center justify-between relative py-2.5 lg:py-1">
                  {# Start / Right in RTL: Logo & Navigation #}
                  <div class="flex items-center gap-3 lg:gap-8">
                      <a data-testid="store-header-mobile-toggle" class="lg:hidden mburger mburger--collapse leading-none rtl:ml-2 ltr:mr-2" href="#mobile-menu" aria-label="Open-menu">
                        <i class="sicon-menu text-[#faf7f2] text-2xl"></i>
                      </a>
                      <a data-testid="store-header-logo" class="navbar-brand flex items-center" href="{{ store.url }}">
                          <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ ('images/anwor-royal-logo.svg'|asset) }}" alt="ANWOR SCENTS OF LUXURY" class="max-h-12 w-auto object-contain">
                          {% if is_page('index') %}
                            <h1 class="sr-only">{{ store.name }}</h1>
                          {% else %}
                            <h2 class="sr-only">{{ store.name }}</h2>
                          {% endif %}
                      </a>
                      <custom-main-menu></custom-main-menu>
                  </div>

                  {# End / Left in RTL: Search, Wishlist, Account, Cart #}
                  <div class="flex items-center justify-end gap-2 sm:gap-3 my-1">
                      {# Search Trigger #}
                      <button type="button" onclick="salla.event.dispatch('search::open')" class="flex items-center justify-center w-9 h-9 rounded-full border border-[#c5a880]/30 text-[#faf7f2] hover:bg-[#cca36e] hover:text-[#121316] hover:border-[#cca36e] transition-all" aria-label="بحث عن عطور">
                        <i class="sicon-search text-base"></i>
                      </button>

                      {# Wishlist Link #}
                      <a href="{{ link('customer.wishlist') }}" class="hidden sm:flex items-center justify-center w-9 h-9 rounded-full border border-[#c5a880]/30 text-[#faf7f2] hover:bg-[#cca36e] hover:text-[#121316] hover:border-[#cca36e] transition-all" aria-label="{{ trans('blocks.header.wishlist') }}" title="{{ trans('blocks.header.wishlist') }}">
                        <i class="sicon-heart text-base"></i>
                      </a>

                      {# User Menu #}
                      <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>

                      {# Cart Summary #}
                      <salla-cart-summary data-testid="store-header-cart">
                        <i slot="icon" class="header-btn__icon icon sicon-shopping-bag text-lg"></i>
                      </salla-cart-summary>
                  </div>
              </div>
          </div>
      </div>
  </div>
</header>
