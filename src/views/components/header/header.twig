{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}
<header data-testid="store-header" class="store-header">
  {# Luxury Fragrance Announcement Bar #}
  {% if theme.settings.get('show_top_ribbon', true) %}
  <div class="perfume-top-ribbon bg-[#cca36e] text-[#121316] text-xs py-2 px-4 text-center font-bold tracking-wide flex items-center justify-center gap-2 shadow-sm">
    <span class="inline-flex items-center gap-1.5 font-bold">
      <span>{{ theme.settings.get('top_ribbon_text', 'عروض حصرية: احصل على خصم 20% على العطور الملكية لفترة محدودة | شحن مجاني للطلبات فوق 500 ريال') }}</span>
    </span>
  </div>
  {% endif %}

  {# Bullet Delivery tag — mobile #}
  <div class="lg:hidden">
    <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
  </div>

  {# Top Nav #}
  <div class="top-navbar">
    <div class="container flex justify-between items-center">
      <div class="flex-1 flex items-center gap-3">
          {# Footer / Header Extra Menu #}
          {% if important_links %}
            <salla-menu data-testid="store-header-topnav" source="footer" topnav></salla-menu>
          {% endif %}

          {# Language & Currency Component #}
          <div class="header-buttons">
              {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
                  <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
              {% endif %}
          </div>

          {# Bullet Delivery tag — desktop #}
          <div class="hidden lg:block">
            <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
          </div>

          {# Scopes | Branches #}
          {% if store.scope %}
              <button class="btn--rounded-gray text-xs"
                      onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
                  <i class="sicon-location rtl:ml-1 ltr:mr-1 text-[#c5a880]"></i> {{ store.scope.name }}
              </button>
          {% endif %}

          {# Search bar #}
          <div class="header-search flex-1 max-w-md">
            <salla-search data-testid="store-header-search" inline oval height="40" placeholder="ابحث عن عطر، ماركة، or مكونات..."></salla-search>
          </div>
      </div>

      <salla-contacts data-testid="store-header-contacts" is-header></salla-contacts>
    </div>
  </div>

  {# Main Nav #}
  <div id="mainnav" class="main-nav-container shadow-default bg-white flex items-center">
      <div class="inner bg-inherit w-full">
          <div class="container">
              <div class="flex items-center justify-between relative py-2 lg:py-0">
                  <div class="flex items-center gap-3 lg:gap-6">
                      <a data-testid="store-header-mobile-toggle" class="lg:hidden mburger mburger--collapse leading-none rtl:ml-2 ltr:mr-2" href="#mobile-menu" aria-label="Open-menu">
                        <i class="sicon-menu text-[#121316] text-2xl"></i>
                      </a>
                      <a data-testid="store-header-logo" class="navbar-brand flex items-center" href="{{ store.url }}">
                          <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo" class="max-h-12 w-auto object-contain">
                          {% if is_page('index') %}
                            <h1 class="sr-only">{{ store.name }}</h1>
                          {% else %}
                            <h2 class="sr-only">{{ store.name }}</h2>
                          {% endif %}
                      </a>
                      <custom-main-menu></custom-main-menu>
                  </div>
                  <div class="flex items-center justify-end gap-3 my-2">
                      {# Wishlist Link #}
                      <a href="{{ link('customer.wishlist') }}" class="hidden sm:flex items-center justify-center w-10 h-10 rounded-full border border-[#c5a880]/30 text-[#121316] hover:bg-[#121316] hover:text-[#dfcaa7] hover:border-[#121316] transition-all" title="{{ trans('blocks.header.wishlist') }}">
                        <i class="sicon-heart text-lg"></i>
                      </a>
                      <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
                      <salla-cart-summary data-testid="store-header-cart">
                        <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
                      </salla-cart-summary>
                  </div>
              </div>
          </div>
      </div>
  </div>
</header>
