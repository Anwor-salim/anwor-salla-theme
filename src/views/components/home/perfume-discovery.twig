{#
  Fragrance Families Section (العائلات العطرية)
  Matching luxury perfume boutique design
#}
<section component-id="{{ componentId }}" class="perfume-discovery-section py-8 md:py-10 my-4" data-testid="store-perfume-discovery">
  <div class="container">
    <div class="mb-5 flex items-center justify-between">
      <h2 class="text-xl sm:text-2xl font-bold text-[#121316] tracking-tight">
        العائلات العطرية
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 md:gap-6">
      {# 1. Oriental / الشرقية #}
      <a href="/search?q={{ 'عطور شرقية'|url_encode }}" class="perfume-family-box group" data-testid="family-card-oriental">
        <div class="family-box-icon">
          <i class="sicon-sparkle"></i>
        </div>
        <h3 class="family-box-title">الشرقية</h3>
      </a>

      {# 2. Floral / الزهرية #}
      <a href="/search?q={{ 'عطور زهرية'|url_encode }}" class="perfume-family-box group" data-testid="family-card-floral">
        <div class="family-box-icon">
          <i class="sicon-flower"></i>
        </div>
        <h3 class="family-box-title">الزهرية</h3>
      </a>

      {# 3. Woody / الخشبية #}
      <a href="/search?q={{ 'عطور خشبية'|url_encode }}" class="perfume-family-box group" data-testid="family-card-woody">
        <div class="family-box-icon">
          <i class="sicon-tree"></i>
        </div>
        <h3 class="family-box-title">الخشبية</h3>
      </a>

      {# 4. Royal Oud / العود الملكي #}
      <a href="/search?q={{ 'عود ملكي'|url_encode }}" class="perfume-family-box group" data-testid="family-card-oud">
        <div class="family-box-icon">
          <i class="sicon-crown"></i>
        </div>
        <h3 class="family-box-title">العود الملكي</h3>
      </a>
    </div>
  </div>
</section>
